# 复制本文件为 .env.local 后填入，重启 dev 服务生效。
# 也可以在页面右上角「模型设置」里直接填写，会存到浏览器 localStorage。

# OpenAI 兼容接口的 Base URL（结尾不要带斜杠）
# OpenAI:      https://api.openai.com/v1
# DeepSeek:    https://api.deepseek.com          （官方地址不带 /v1）
# 豆包/火山:    https://ark.cn-beijing.volces.com/api/v3
# 通义兼容:     https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_LLM_BASE_URL=https://api.openai.com/v1

# 各平台 Key 格式不同，火山方舟不是 sk- 开头，原样粘贴
VITE_LLM_API_KEY=

# 火山方舟预置接入点直接填 Model ID，如 deepseek-v4-1-flash-261017；自定义接入点才填 ep-xxx
VITE_LLM_MODEL=gpt-4o-mini
